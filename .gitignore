# Secrets and local state: never commit.
.env

# Tooling.
.DS_Store
.idea/
.vscode/

# Local production overrides: never committed (backend URLs are built in as fallbacks).
.env.production

# CI scripts: local runs.
dist-ci/
__pycache__/

# Local agent files: the workspace setup script writes them (absolute paths of this workspace).
CLAUDE.local.md
AGENTS.local.md

# Background dev servers of dev-tools/up-dev.sh: logs and process ids.
.up-dev/
