{
  "name": "up-miniapps-demo-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Studio plugin of the Up demo mini-app: its admin page, loaded at runtime by the Up Studio",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --test dev/devHost.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --max-diagnostics 10000 --diagnostic-level error",
    "check:write": "biome check . --write --max-diagnostics 10000 --diagnostic-level error"
  },
  "dependencies": {
    "@cloudparse/up-backoffice-sdk": "^0.3.1",
    "lucide-react": "^1.55.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
