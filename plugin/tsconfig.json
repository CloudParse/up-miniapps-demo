{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@plugin/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "dev",
    "vite.config.ts",
    "vite.dev.config.ts",
    "../dev-tools/hostGuard.ts"
  ]
}
