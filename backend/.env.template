# Copy to `.env` (gitignored). These override configs/config.toml:
# the dotted TOML key, upper-cased with underscores (hub.app_uuid -> HUB_APP_UUID).
# Fill them with the uuid and the client secret your organisation admin gives you
# once the mini-app is registered. Never commit the real file.

HUB_APP_UUID=
HUB_CLIENT_SECRET=

# The Hub's public key is read from /etc/up-platform/jwt/public.pem (hub.public_key_path):
# see ../docs/coder.md, "Limits".
