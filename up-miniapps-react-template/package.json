{
  "name": "up-miniapps-react-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reference Up mini-app frontend for students, built on @cloudparse/up-miniapps-sdk.",
  "scripts": {
    "dev": "vite",
    "build": "up-sdk build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --max-diagnostics 10000 --diagnostic-level error",
    "check": "biome check . --max-diagnostics 10000 --diagnostic-level error",
    "check:write": "biome check . --write --max-diagnostics 10000 --diagnostic-level error",
    "format": "biome format . --write --max-diagnostics 10000 --diagnostic-level error"
  },
  "dependencies": {
    "@cloudparse/up-miniapps-sdk": "^0.15.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.11.0",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
