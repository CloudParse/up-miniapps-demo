# Copy to `.env` (gitignored). Only VITE_* variables reach the browser bundle:
# never put a secret in here.

# Base URL of this mini-app's backend (the FastAPI project in ../up-miniapps-template-python-backend), including /api/v1.
# Ignored in a production build: the shell injects the real URL registered on the Hub.
VITE_BACKEND_URL=http://localhost:21514/api/v1

# Optional dev-only JWT sent by the standalone simulator. Never bundled in production.
VITE_DEV_TOKEN=
