# Copy to `.env` (gitignored). Only VITE_* variables reach the browser bundle:
# never put a secret in here.

# URL of the demo API (../api), including /api/v1. A path goes through
# the Vite dev server's proxy to http://127.0.0.1:21514 (vite.config.ts): it works
# on localhost and behind a Coder port URL. An absolute URL is called directly.
# Ignored in a production build: the shell injects the real URL registered on the Hub.
VITE_BACKEND_URL=/api/v1

# Optional dev-only JWT sent by the standalone simulator. Never bundled in production.
VITE_DEV_TOKEN=

# DEV_ALLOWED_HOSTS does not go here: Vite reads it from the shell when it loads
# vite.config.ts (DEV_ALLOWED_HOSTS=.example.com npm run dev).
