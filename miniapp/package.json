{
  "name": "up-miniapps-demo-miniapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Up demo mini-app: every @cloudparse/up-miniapps-sdk capability in one app, talking to the demo API.",
  "scripts": {
    "dev": "vite",
    "build": "up-sdk build",
    "preview": "vite preview",
    "test": "node --test ../dev-tools/hostGuard.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --max-diagnostics 10000 --diagnostic-level error",
    "check": "biome check . --max-diagnostics 10000 --diagnostic-level error",
    "check:write": "biome check . --write --max-diagnostics 10000 --diagnostic-level error",
    "format": "biome format . --write --max-diagnostics 10000 --diagnostic-level error"
  },
  "dependencies": {
    "@cloudparse/up-miniapps-sdk": "0.17.0",
    "@vis.gl/react-maplibre": "^8.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.22.0",
    "maplibre-gl": "^6.11.1",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
